# Base URL of the backend API.
# In development the Vite dev server proxies "/api" to the backend (see vite.config.js),
# so this is mainly used for production builds where there is no dev proxy.
VITE_API_URL=/api
# For a separate production API origin, replace this with the HTTPS API URL.
# Google Identity Services client ID (optional until Google Cloud OAuth is configured).
VITE_GOOGLE_CLIENT_ID=
