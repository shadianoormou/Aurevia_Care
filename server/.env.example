# Server
PORT=5000
NODE_ENV=development

# Microsoft SQL Server / Azure SQL
# For Azure SQL, use the fully qualified server name, e.g. my-server.database.windows.net
DB_SERVER=your_sql_server_host
DB_PORT=1433
DB_NAME=aurevia_care
DB_USER=your_sql_login
DB_PASSWORD=your_strong_sql_password
# Keep true for local development only. Production and Azure SQL should be false.
DB_TRUST_SERVER_CERTIFICATE=false
DB_ENCRYPT=true
# Optional local SQL Server LocalDB driver. Leave blank for Azure SQL or regular SQL Server.
# DB_DRIVER=msnodesqlv8
# DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=(localdb)\\MSSQLLocalDB;Database=aurevia_care;Trusted_Connection=Yes;TrustServerCertificate=Yes;

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=30d

# Browser session cookies. Use none only when frontend and API are on different HTTPS domains.
COOKIE_SAME_SITE=lax

# Cloudinary (optional: product image upload)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Azure AI Document Intelligence. When configured, uploaded prescriptions
# are OCR-extracted before pharmacist review. Without these values, review stays manual.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Google Identity Services. Use the same OAuth web client ID as the frontend.
GOOGLE_CLIENT_ID=

# Order status email notifications (optional but recommended for production).
# Gmail users should use an app password, not their normal account password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Aurevia Care <no-reply@example.com>

# Production bootstrap administrator (used by the explicit seed command only)
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=use_a_unique_12_plus_character_password
