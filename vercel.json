{
  "version": 2,
  "installCommand": "npm install && npm install --prefix client",
  "buildCommand": "node scripts/vercel-build.mjs",
  "builds": [
    { "src": "api/index.mjs", "use": "@vercel/node" },
    { "src": "client/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.mjs" },
    { "handle": "filesystem" },
    { "src": "/(assets/.*)", "dest": "/client/$1" },
    { "src": "/(.*\\.(?:js|css|svg|png|jpg|jpeg|webp|ico|woff2?))", "dest": "/client/$1" },
    {
      "src": "/(.*)",
      "dest": "/client/index.html",
      "headers": { "Cross-Origin-Opener-Policy": "same-origin-allow-popups" }
    }
  ]
}
